local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

local slapple = workspace.Arena.island5.Slapples.Slapple

if slapple.PrimaryPart then
    character:PivotTo(slapple.PrimaryPart.CFrame)
else
    local part = slapple:FindFirstChildWhichIsA("BasePart", true)
    if part then
        character:PivotTo(part.CFrame)
    end
end
